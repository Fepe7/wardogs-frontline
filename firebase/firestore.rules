rules_version = '2';

// Clients never write: every write goes through Cloud Functions (Admin SDK),
// which bypass these rules. Public reads are opened collection by collection
// as each feature lands, each one with its test (docs/ARQUITECTURA.md §7).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
