    "@frontline/contracts": "workspace:*",
    "@frontline/core": "workspace:*",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/signals": "^22.0.1",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
